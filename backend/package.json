{
  "name": "cwu-app-backend",
  "version": "1.0.0",
  "description": "CWU App (Clean Windows Utility): servidor local + Electron para otimização do Windows",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron electron-main.js",
    "app": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "check-winget": "node scripts/check-winget.js",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.cwuapp.utility",
    "productName": "CWU App",
    "directories": {
      "output": "../release"
    },
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "CWU-App-Portable-${version}.${ext}"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "src/**/*",
      "build/icon.png",
      "!tests",
      "!scripts"
    ],
    "asar": true
  },
  "keywords": [
    "cwu",
    "drivers",
    "post-format",
    "windows-specs",
    "bsod-analyzer"
  ],
  "author": "Filipi Soares",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
