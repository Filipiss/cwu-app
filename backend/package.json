{
  "name": "cwu-app-backend",
  "version": "1.2.1",
  "description": "CWU App: pós-formatação e otimização do Windows para jogos",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron electron-main.js",
    "app": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "check-winget": "node scripts/check-winget.js",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.cwuapp.utility",
    "productName": "CWU App",
    "directories": {
      "output": "../release"
    },
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe",
          "*.txt",
          "*.md"
        ]
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "src/**/*",
      "build/icon.png",
      "!tests",
      "!scripts"
    ],
    "asar": true,
    "nsis": {
      "artifactName": "CWU-App-Setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CWU App",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Filipiss",
        "repo": "cwu-app"
      }
    ]
  },
  "keywords": [
    "cwu",
    "drivers",
    "post-format",
    "windows-specs",
    "bsod-analyzer"
  ],
  "author": "Filipi Soares",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
